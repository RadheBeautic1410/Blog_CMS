// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Blog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String   @unique
  excerpt       String   // Short Description
  content       String   // Rich Text Content
  author        String
  authorId      String?  // Reference to Author
  category      String
  categoryId    String?  // Reference to Category
  image         String   // Featured Image
  tags          String[] // Array of tags
  status        String   @default("draft") // draft, published
  metaTitle     String?
  metaDescription String?
  featured      Boolean  @default(false)
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("blogs")
}

model Category {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String @unique
  slug  String @unique
  count Int    @default(0)

  @@map("categories")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin") // admin, editor, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Author {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String?  @unique
  bio         String?
  avatar      String?  // Profile image URL
  website     String?
  socialLinks Json?    // { twitter, linkedin, github, etc. }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("authors")
}

model Media {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  url         String   @unique
  alt         String?
  caption     String?
  description String?
  mimeType    String?  // image/jpeg, image/png, etc.
  size        Int?     // File size in bytes
  width       Int?     // Image width in pixels
  height      Int?     // Image height in pixels
  folder      String?  // blogs, authors, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("media")
}

model NewsletterSubscriber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------------
// Orbit: daily automated blog writing + publishing
// ---------------------------------------------------------------------------

model OrbitSettings {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  key               String    @unique @default("default") // singleton row
  enabled           Boolean   @default(false)
  provider          String    @default("gemini") // gemini, anthropic, openai, groq
  model             String    @default("gemini-2.5-flash")
  autoPublish       Boolean   @default(false) // false => save as draft for review
  authorId          String?   // Author used for generated posts
  categories        String[]  // categories Orbit may write for
  defaultImage      String?   // fallback featured image URL
  wordCount         Int       @default(1200)
  tone              String    @default("informative, friendly and SEO-optimized")
  language          String    @default("English")
  extraInstructions String?   // free-form house style rules
  lastRunAt         DateTime?
  lastRunStatus     String?   // success, failed, skipped
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("orbit_settings")
}

model OrbitTopic {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  keywords  String[]
  category  String?
  notes     String?
  status    String    @default("pending") // pending, used, failed
  source    String    @default("manual")  // manual, ai
  usedAt    DateTime?
  blogId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("orbit_topics")
}

model OrbitRun {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  status     String   // success, failed, skipped
  trigger    String   // cron, manual
  topic      String?
  topicId    String?
  blogId     String?
  blogSlug   String?
  blogTitle  String?
  blogStatus String?  // published, draft
  provider   String?
  model      String?
  message    String?
  error      String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@map("orbit_runs")
}
